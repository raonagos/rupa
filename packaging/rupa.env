# Instance settings for rupa.service.
#
# The VPN configuration itself — interface, address, UDP port, endpoint, peers
# and DNS records — lives in the SQLite database, not here: `rupa init`,
# `rupa peer add` and `rupa dns add` are the interface to it.
#
# This file only carries what systemd hands to the process. Keep RUPA_DB inside
# /var/lib/rupa: the unit runs with ProtectSystem=strict and only the state
# directory (and /run/rupa) is writable.

RUPA_DB=/var/lib/rupa/rupa.db
RUST_LOG=info
