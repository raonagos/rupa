[Unit]
Description=rupa WireGuard VPN server and private DNS
Documentation=https://github.com/raonagos/rupa
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/rupa up
Restart=on-failure
RestartSec=2
StartLimitBurst=5
KillSignal=SIGTERM
TimeoutStopSec=10

# The TUN device, UDP socket and DNS :53 need root.
User=root
StateDirectory=rupa
StateDirectoryMode=0700
RuntimeDirectory=rupa
RuntimeDirectoryMode=0750

# Keep the service on the network/UNIX side; it does not need the rest.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=no
ReadWritePaths=/var/lib/rupa /run/rupa
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
