[Unit]
Description=rupa WireGuard VPN server and private DNS
Documentation=https://github.com/raonagos/rupa
After=network-online.target
Wants=network-online.target

[Service]
# systemd defaults left implicit: Type=simple, User=root, KillSignal=SIGTERM,
# StartLimitBurst, PrivateDevices=no.
ExecStart=/usr/bin/rupa up
EnvironmentFile=-/etc/rupa/rupa.env

Restart=on-failure
RestartSec=2
TimeoutStopSec=10

# The TUN device, the UDP socket and DNS :53 need root; the rest is narrowed
# down. StateDirectory and RuntimeDirectory are writable even with
# ProtectSystem=strict, so there is no ReadWritePaths to duplicate.
StateDirectory=rupa
StateDirectoryMode=0700
RuntimeDirectory=rupa
RuntimeDirectoryMode=0750
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
